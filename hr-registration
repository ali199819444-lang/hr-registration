<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>استمارة تسجيل الموظفين الجدد</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f6fb;--card:#fff;--tx:#1b2a41;--mut:#6b7a90;--pri:#0f4c81;--pri2:#1b6ec2;--bd:#d9e2ef;--ok:#1a9c5b;--err:#c0392b}
*{box-sizing:border-box}
body{margin:0;font-family:'Cairo',Tahoma,sans-serif;background:var(--bg);color:var(--tx)}
header{background:linear-gradient(135deg,#0a2f55 0%,var(--pri) 55%,var(--pri2) 100%);color:#fff;padding:0 16px 46px;text-align:center;position:relative;overflow:hidden}
header::after{content:"";position:absolute;width:320px;height:320px;border-radius:50%;background:rgba(255,255,255,.06);top:-140px;left:-90px}
.topbar{max-width:760px;margin:0 auto;display:flex;align-items:center;gap:12px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.2);text-align:right;position:relative;z-index:1}
.logo{width:46px;height:46px;border-radius:12px;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:1.4rem;flex:none}
.org b{display:block;font-size:1.1rem}.org span{font-size:.85rem;opacity:.85}
header h1{margin:22px 0 6px;font-size:1.6rem;position:relative;z-index:1}header p{margin:0;opacity:.9;position:relative;z-index:1}
.seg{display:flex;gap:10px}.seg label{flex:1;margin:0;cursor:pointer}
.seg input{position:absolute;opacity:0;width:0}
.seg span{display:block;text-align:center;padding:11px;border:1px solid var(--bd);border-radius:9px;font-weight:600}
.seg input:checked+span{background:var(--pri);color:#fff;border-color:var(--pri)}
footer{text-align:center;color:var(--mut);font-size:.88rem;padding:6px 0 26px}footer b{color:var(--pri)}
.wrap{max-width:760px;margin:-20px auto 40px;padding:0 14px}
.card{background:var(--card);border-radius:14px;padding:22px;box-shadow:0 4px 18px rgba(15,76,129,.1);margin-bottom:16px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.full{grid-column:1/-1}
label{display:block;font-weight:600;margin-bottom:5px;font-size:.92rem}
label small{color:var(--mut);font-weight:400}
input,textarea,select{width:100%;padding:11px 12px;border:1px solid var(--bd);border-radius:9px;font:inherit;background:#fff}
input:focus,textarea:focus{outline:2px solid var(--pri2);border-color:transparent}
textarea{min-height:100px;resize:vertical}
button{font:inherit;cursor:pointer;border:0;border-radius:9px;padding:11px 20px;font-weight:700}
.btn{background:var(--pri);color:#fff}.btn:hover{background:var(--pri2)}
.btn2{background:#e8eef7;color:var(--pri)}.btn-wa{background:#25d366;color:#fff;display:inline-block;text-decoration:none;padding:12px 22px;border-radius:9px;font-weight:700}
.btn-del{background:#fdecea;color:var(--err);padding:5px 10px}
.msg{padding:12px;border-radius:9px;margin-top:12px;display:none}
.msg.ok{background:#e6f6ee;color:var(--ok);display:block}.msg.err{background:#fdecea;color:var(--err);display:block}
.hidden{display:none!important}
.admin-link{text-align:center;margin-top:8px}
.admin-link button{background:none;color:var(--mut);font-weight:400;text-decoration:underline}
.bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.bar input{flex:1;min-width:160px}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.85rem}
th,td{border-bottom:1px solid var(--bd);padding:8px;text-align:right;white-space:nowrap;vertical-align:top}
td.long{white-space:normal;min-width:200px}
th{background:#eef3fa;position:sticky;top:0}
.stat{font-weight:700;color:var(--pri)}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header>
  <div class="topbar"><div class="logo">🏛️</div><div class="org"><b>هيئة استثمار البصرة</b><span>قسم الموارد البشرية</span></div></div>
  <h1>استمارة تسجيل الموظفين الجدد</h1><p>يرجى تعبئة البيانات بدقة، وستتم مراجعتها من قبل الإدارة</p>
</header>

<div class="wrap">
  <!-- نموذج التسجيل -->
  <div id="formView" class="card">
    <form id="regForm" class="grid" autocomplete="off">
      <div class="full"><label>الاسم الثلاثي *</label><input id="name" required minlength="6"></div>
      <div><label>العمر *</label><input id="age" type="number" min="18" max="70" required></div>
      <div><label>الجنس *</label><div class="seg"><label><input type="radio" name="gender" value="ذكر" required><span>ذكر</span></label><label><input type="radio" name="gender" value="أنثى"><span>أنثى</span></label></div></div>
      <div><label>رقم الهاتف *</label><input id="phone" type="tel" inputmode="tel" placeholder="07xxxxxxxxx" required pattern="[0-9+\s]{9,15}"></div>
      <div><label>البريد الإلكتروني *</label><input id="email" type="email" required dir="ltr" style="text-align:right"></div>
      <div class="full"><label>الاختصاص الدقيق *</label><input id="spec" required></div>
      <div class="full"><label>مكان العمل السابق <small>(اختياري)</small></label><input id="prev"></div>
      <div class="full"><label>مكان السكن *</label><input id="addr" required placeholder="المحافظة / المنطقة"></div>
      <div class="full"><label>نبذة شخصية *</label><textarea id="bio" required maxlength="1000" placeholder="عرّف بنفسك وبخبراتك ومهاراتك..."></textarea></div>
      <div class="full"><button class="btn" id="sendBtn" style="width:100%">إرسال الاستمارة</button></div>
    </form>
    <div id="formMsg" class="msg"></div>
  </div>

  <!-- بعد الإرسال -->
  <div id="doneView" class="card hidden" style="text-align:center">
    <h2 style="color:var(--ok)">✔ تم استلام طلبك بنجاح</h2>
    <p>شكراً لك، سيتم التواصل معك عند الحاجة.</p>
    <div id="waBox" class="hidden">
      <p>يمكنك الانضمام إلى مجموعة الواتساب الخاصة بالمتقدمين (اختياري):</p>
      <a id="waLink" class="btn-wa" target="_blank" rel="noopener">انضمام إلى مجموعة واتساب</a>
    </div>
    <p><button class="btn2" onclick="location.reload()">تسجيل متقدم آخر</button></p>
  </div>

  <div class="admin-link"><button id="adminOpen">دخول الإدارة</button></div>

  <!-- دخول الإدارة -->
  <div id="loginView" class="card hidden">
    <label>رمز الإدارة</label>
    <div class="bar"><input id="code" type="password" placeholder="أدخل الرمز"><button class="btn" id="loginBtn">دخول</button></div>
    <div id="loginMsg" class="msg"></div>
  </div>

  <!-- لوحة الإدارة -->
  <div id="adminView" class="hidden">
    <div class="card">
      <h3 style="margin-top:0">رابط مجموعة الواتساب <small style="color:var(--mut)">(اختياري)</small></h3>
      <div class="bar">
        <input id="waInput" dir="ltr" placeholder="https://chat.whatsapp.com/xxxxxxxx">
        <button class="btn" id="waSave">حفظ</button>
        <button class="btn2" id="waClear">حذف الرابط</button>
      </div>
      <div id="waMsg" class="msg"></div>
    </div>
    <div class="card">
      <div class="bar">
        <span class="stat" id="count">0 متقدم</span>
        <input id="q" placeholder="بحث بالاسم أو الاختصاص أو السكن...">
        <button class="btn" id="xlsBtn">تصدير Excel</button>
        <button class="btn2" id="logoutBtn">خروج</button>
      </div>
      <div class="tw"><table><thead><tr>
        <th>#</th><th>الاسم</th><th>العمر</th><th>الجنس</th><th>الهاتف</th><th>الإيميل</th><th>الاختصاص</th><th>العمل السابق</th><th>السكن</th><th>النبذة</th><th>التاريخ</th><th></th>
      </tr></thead><tbody id="rows"></tbody></table></div>
    </div>
  </div>
  <footer>تصميم وبرمجة: <b>علي مصطفى عبد</b></footer>
</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
/* ===== 1) ضع إعدادات Firebase هنا (Project settings ← Your apps ← Config) ===== */
const firebaseConfig = {
  apiKey: "AIzaSyDX17rhe4K2jP4ZGI34Yiz5u5Hl37RfBuk",
  authDomain: "tasgel-101cd.firebaseapp.com",
  projectId: "tasgel-101cd",
  storageBucket: "tasgel-101cd.firebasestorage.app",
  messagingSenderId: "365495102492",
  appId: "1:365495102492:web:b5d460f429daf01d87c3d9"
};
/* ===== 2) إيميل الإدارة (نفس المستخدم المنشأ في Authentication) — رمز الدخول هو كلمة مروره ===== */
const ADMIN_EMAIL = "ali19981934@gmail.com";

/*
===== قواعد Firestore (Rules) — انسخها كما هي =====
rules_version = '2';
service cloud.firestore { match /databases/{db}/documents {
  match /submissions/{id} { allow create: if true; allow read, update, delete: if request.auth != null; }
  match /settings/{id}     { allow read: if true;   allow write: if request.auth != null; }
}}
*/

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth(), db = firebase.firestore();
const $ = id => document.getElementById(id);
const show = (el, on = true) => el.classList.toggle('hidden', !on);
const flash = (el, t, ok = true) => { el.className = 'msg ' + (ok ? 'ok' : 'err'); el.textContent = t; };
let all = [], unsub = null;

/* رابط الواتساب (يقرؤه الجميع) */
async function loadWa() {
  try {
    const d = await db.collection('settings').doc('whatsapp').get();
    const url = d.exists ? (d.data().url || '') : '';
    $('waInput').value = url;
    return url;
  } catch (e) { return ''; }
}

/* إرسال الاستمارة */
$('regForm').addEventListener('submit', async e => {
  e.preventDefault();
  $('sendBtn').disabled = true;
  const data = {
    name: $('name').value.trim(), age: +$('age').value, gender: document.querySelector('input[name=gender]:checked').value, phone: $('phone').value.trim(),
    email: $('email').value.trim(), spec: $('spec').value.trim(), prev: $('prev').value.trim(),
    addr: $('addr').value.trim(), bio: $('bio').value.trim(),
    createdAt: firebase.firestore.FieldValue.serverTimestamp()
  };
  try {
    await db.collection('submissions').add(data);
    const url = await loadWa();
    show($('formView'), false); show($('adminOpen').parentElement, false); show($('doneView'));
    if (/^https:\/\/(chat\.whatsapp\.com|wa\.me)\//.test(url)) { $('waLink').href = url; show($('waBox')); }
  } catch (err) {
    flash($('formMsg'), 'تعذّر الإرسال، تحقق من الاتصال وإعدادات Firebase.', false);
    $('sendBtn').disabled = false;
  }
});

/* دخول الإدارة */
$('adminOpen').onclick = () => show($('loginView'), $('loginView').classList.contains('hidden'));
$('loginBtn').onclick = async () => {
  try {
    await auth.signInWithEmailAndPassword(ADMIN_EMAIL, $('code').value);
    $('code').value = '';
  } catch (e) { flash($('loginMsg'), 'الرمز غير صحيح', false); }
};
$('code').addEventListener('keydown', e => { if (e.key === 'Enter') $('loginBtn').click(); });
$('logoutBtn').onclick = () => auth.signOut();

function enter(isAdmin) {
  if (unsub) { unsub(); unsub = null; }
  show($('adminView'), isAdmin); show($('loginView'), false);
  show($('formView'), !isAdmin); show($('doneView'), false); show($('adminOpen').parentElement, !isAdmin);
  if (!isAdmin) return;
  loadWa();
  unsub = db.collection('submissions').orderBy('createdAt', 'desc').onSnapshot(s => {
    all = s.docs.map(d => ({ id: d.id, ...d.data() }));
    render();
  });
}
auth.onAuthStateChanged(u => enter(!!u));

/* حفظ / حذف رابط الواتساب */
$('waSave').onclick = async () => {
  const url = $('waInput').value.trim();
  if (!/^https:\/\/(chat\.whatsapp\.com|wa\.me)\//.test(url)) return flash($('waMsg'), 'أدخل رابط دعوة واتساب صحيح', false);
  await db.collection('settings').doc('whatsapp').set({ url });
  flash($('waMsg'), 'تم حفظ الرابط');
};
$('waClear').onclick = async () => {
  await db.collection('settings').doc('whatsapp').set({ url: '' });
  $('waInput').value = ''; flash($('waMsg'), 'تم حذف الرابط');
};

/* الجدول */
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const fmt = r => r.createdAt?.toDate ? r.createdAt.toDate().toLocaleString('ar-IQ') : '';
function filtered() {
  const q = $('q').value.trim().toLowerCase();
  return !q ? all : all.filter(r => [r.name, r.spec, r.addr, r.prev, r.phone, r.email].join(' ').toLowerCase().includes(q));
}
function render() {
  const list = filtered();
  $('count').textContent = list.length + ' متقدم';
  $('rows').innerHTML = list.map((r, i) => `<tr>
    <td>${i + 1}</td><td>${esc(r.name)}</td><td>${esc(r.age)}</td><td>${esc(r.gender)}</td><td dir="ltr">${esc(r.phone)}</td><td dir="ltr">${esc(r.email)}</td>
    <td>${esc(r.spec)}</td><td>${esc(r.prev)}</td><td>${esc(r.addr)}</td><td class="long">${esc(r.bio)}</td><td>${esc(fmt(r))}</td>
    <td><button class="btn-del" data-id="${r.id}">حذف</button></td></tr>`).join('');
}
$('q').oninput = render;
$('rows').onclick = async e => {
  const id = e.target.dataset.id;
  if (id && confirm('حذف هذا السجل نهائياً؟')) await db.collection('submissions').doc(id).delete();
};

/* تصدير Excel */
$('xlsBtn').onclick = () => {
  const rows = filtered().map((r, i) => ({
    '#': i + 1, 'الاسم': r.name, 'العمر': r.age, 'الجنس': r.gender, 'الهاتف': r.phone, 'الإيميل': r.email,
    'الاختصاص الدقيق': r.spec, 'مكان العمل السابق': r.prev, 'السكن': r.addr, 'نبذة': r.bio, 'تاريخ التسجيل': fmt(r)
  }));
  const ws = XLSX.utils.json_to_sheet(rows);
  ws['!cols'] = [6, 24, 8, 8, 16, 26, 24, 24, 22, 50, 20].map(w => ({ wch: w }));
  const wb = XLSX.utils.book_new(); wb.Workbook = { Views: [{ RTL: true }] };
  XLSX.utils.book_append_sheet(wb, ws, 'المتقدمون');
  XLSX.writeFile(wb, 'الموظفون_الجدد.xlsx');
};
</script>
</body>
</html>
